# Copie para .env e preencha. O .env NÃO vai para o Git.

# Firebase (console.firebase.google.com → Configurações do projeto → Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=capitalcycle-tcc
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Capital Advisor (Gemini)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash

# Open Finance (Pluggy) — dashboard.pluggy.ai → Applications
VITE_PLUGGY_CLIENT_ID=
VITE_PLUGGY_CLIENT_SECRET=
# true = mostra o "Pluggy Bank" de testes no widget (user-ok / password-ok)
VITE_PLUGGY_SANDBOX=true
