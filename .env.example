# Copie para .env e preencha. O .env NÃO vai para o Git.
#
# Como estas variáveis chegam ao navegador (prefixo VITE_), nenhuma delas é
# secreta de verdade: a chave do Gemini e o client secret do Pluggy ficam
# legíveis no bundle. Para o TCC isso foi aceito (dados de sandbox e cota
# gratuita); em produção real as duas chamadas devem passar por um backend
# (Cloud Function) que guarde as chaves. Veja docs/SEGURANCA.md.

# Firebase (console.firebase.google.com → Configurações do projeto → Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=capitalcycle-tcc
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Capital Advisor (Gemini) — sem a chave, a tela do Advisor fica desativada
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash

# Open Finance (Pluggy) — dashboard.pluggy.ai → Applications
# Sem as duas chaves, a tela Open Finance avisa que não está configurada e o
# restante do app funciona normalmente com a carteira manual.
VITE_PLUGGY_CLIENT_ID=
VITE_PLUGGY_CLIENT_SECRET=
# true = mostra o "Pluggy Bank" de testes no widget (user-ok / password-ok)
VITE_PLUGGY_SANDBOX=true
