rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────────────────────────
    // Princípios
    //   1. Cada pessoa só lê e escreve o que é dela (campo `uid`).
    //   2. Todo documento de dados tem forma validada na escrita: tipo dos
    //      campos, valores permitidos e formato de data. Isso impede que um
    //      cliente alterado grave lixo (valor negativo, tipo inventado,
    //      data fora do padrão) que depois quebra os cálculos das telas.
    //   3. `uid` nunca muda depois de criado.
    // ───────────────────────────────────────────────────────────────────

    function logado() {
      return request.auth != null;
    }

    function dono(dados) {
      return logado() && dados.uid == request.auth.uid;
    }

    // Leitura de um documento que PODE não existir (ex.: `get` dentro de
    // uma transação antes de criar a carteira manual). Sem isto a avaliação
    // de `resource.data` em documento inexistente falha e nega a leitura.
    function donoOuInexistente() {
      return logado() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // 'YYYY-MM-DD'
    function dataValida(valor) {
      return valor is string && valor.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function numeroNaoNegativo(valor) {
      return valor is number && valor >= 0;
    }

    function textoCurto(valor, max) {
      return valor is string && valor.size() > 0 && valor.size() <= max;
    }

    // Perfil do usuário — cada um só lê/escreve o próprio documento.
    // O perfil guarda nome, plano, renda, foto (Data URL pequena), uso da IA,
    // aceite dos termos e a preferência de contexto do Advisor.
    match /usuarios/{userId} {
      allow read: if logado() && request.auth.uid == userId;
      allow create, update: if logado() && request.auth.uid == userId
        && (!('renda_mensal' in request.resource.data) || numeroNaoNegativo(request.resource.data.renda_mensal))
        && (!('advisorContexto' in request.resource.data) || request.resource.data.advisorContexto is bool)
        && (!('fotoPerfil' in request.resource.data) || request.resource.data.fotoPerfil == null
            || (request.resource.data.fotoPerfil is string && request.resource.data.fotoPerfil.size() <= 120000));
      allow delete: if logado() && request.auth.uid == userId;
    }

    // Contas (carteira manual e contas importadas pelo Open Finance)
    match /accounts/{accountId} {
      function contaValida(d) {
        return textoCurto(d.nome, 80)
          && d.saldo is number
          && d.tipo in ['Corrente', 'Poupança', 'Cartão de crédito', 'Investimentos']
          && (!('origem' in d) || d.origem in ['manual', 'openfinance']);
      }
      allow get: if donoOuInexistente();
      allow list: if dono(resource.data);
      allow create: if dono(request.resource.data) && contaValida(request.resource.data);
      allow update: if dono(resource.data)
        && request.resource.data.uid == resource.data.uid
        && contaValida(request.resource.data);
      allow delete: if dono(resource.data);
    }

    // Transações
    match /transactions/{transactionId} {
      function transacaoValida(d) {
        return textoCurto(d.descricao, 160)
          && numeroNaoNegativo(d.valor)
          && d.tipo in ['entrada', 'saida']
          && textoCurto(d.categoria, 40)
          && dataValida(d.data)
          && (!('origem' in d) || d.origem in ['manual', 'openfinance']);
      }
      allow read: if dono(resource.data);
      allow create: if dono(request.resource.data) && transacaoValida(request.resource.data);
      allow update: if dono(resource.data)
        && request.resource.data.uid == resource.data.uid
        && transacaoValida(request.resource.data);
      allow delete: if dono(resource.data);
    }

    // Ciclos (metas e orçamentos por período)
    match /ciclos/{cicloId} {
      function cicloValido(d) {
        return textoCurto(d.nome, 80)
          && d.tipo in ['Meta', 'Orçamento']
          && d.orcamento is number && d.orcamento > 0
          && dataValida(d.inicio) && dataValida(d.fim)
          && d.fim >= d.inicio;
      }
      allow read: if dono(resource.data);
      allow create: if dono(request.resource.data) && cicloValido(request.resource.data);
      allow update: if dono(resource.data)
        && request.resource.data.uid == resource.data.uid
        && cicloValido(request.resource.data);
      allow delete: if dono(resource.data);

      // Aportes de uma meta — uid denormalizado no próprio aporte para não
      // precisar de get() extra no ciclo pai.
      match /aportes/{aporteId} {
        function aporteValido(d) {
          return d.valor is number && d.valor > 0 && dataValida(d.data);
        }
        allow read: if dono(resource.data);
        allow create: if dono(request.resource.data) && aporteValido(request.resource.data);
        allow update: if dono(resource.data)
          && request.resource.data.uid == resource.data.uid
          && aporteValido(request.resource.data);
        allow delete: if dono(resource.data);
      }
    }

    // Limites de orçamento por categoria — um documento por usuário.
    match /orcamentosPorCategoria/{userId} {
      allow read: if logado() && request.auth.uid == userId;
      allow write: if logado() && request.auth.uid == userId
        && request.resource.data.limites is map;
      allow delete: if logado() && request.auth.uid == userId;
    }

    // Pagamentos / comprovantes — cada usuário só vê e cria os seus.
    // O id do documento é gerado como `${uid}_${idTransacao}`, então só o
    // próprio dono pode criar e ninguém consegue editar/excluir um
    // pagamento já registrado.
    match /pagamentos/{pagamentoId} {
      allow read: if dono(resource.data);
      allow create: if dono(request.resource.data)
        && request.resource.data.status == 'aprovado'
        && request.resource.data.plan in ['jovem', 'adulto']
        && request.resource.data.metodo in ['pix', 'cartao']
        && numeroNaoNegativo(request.resource.data.valor)
        && request.resource.data.keys().hasAll(['uid', 'plan', 'metodo', 'valor', 'idTransacao', 'status']);
      allow update, delete: if false;
    }

    // Tudo o mais fica bloqueado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
