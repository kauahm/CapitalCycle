rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário — cada um só lê/escreve o próprio documento
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contas bancárias/carteiras — só o dono (campo uid) pode ler/escrever
    match /accounts/{accountId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    // Transações — só o dono (campo uid) pode ler/escrever
    match /transactions/{transactionId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    // Ciclos / Metas / Orçamentos — só o dono (campo uid) pode ler/escrever
    match /ciclos/{cicloId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    // Pagamentos / comprovantes — cada usuário só vê e cria os seus.
    // O id do documento é gerado como `${uid}_${idTransacao}`, então só o
    // próprio dono pode criar (o uid precisa bater com o auth) e ninguém
    // consegue editar/excluir um pagamento já registrado.
    match /pagamentos/{pagamentoId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'aprovado'
        && request.resource.data.keys().hasAll(['uid', 'plan', 'metodo', 'valor', 'idTransacao', 'status']);
      allow update, delete: if false;
    }

    // Tudo o mais fica bloqueado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
